theme = light:Gruvbox Material Light,dark:Gruvbox Material Dark
# theme = Gruvbox Material Dark

# ------------------------------------------------------------
# Acrylic window
# ------------------------------------------------------------
# Subtle translucency. Real compositor blur is unavailable (ghostty
# 1.3.x can't speak Plasma 6.7's ext-background-effect-v1 protocol), so
# stay at 0.96 where the unblurred bleed-through remains a faint
# presence; the frosted-glass shader adds the acrylic surface finish.
# Work stays legible: background-opacity-cells defaults to false, so
# cells with explicit background colors (statuslines, selections, tmux
# bars) remain fully opaque, and minimum-contrast floors text contrast.
background-opacity = 0.96
background-blur = true
minimum-contrast = 1.1

# Titlebar follows the terminal theme: window-theme=ghostty maps the GTK
# headerbar colors to the active theme's bg/fg (opaque, so the old
# see-through-headerbar problem the custom CSS used to patch is gone),
# and tracks the light:/dark: conditional theme automatically.
window-decoration = client
window-theme = ghostty

# ------------------------------------------------------------
# Ghostty tab and window settings
# ------------------------------------------------------------
# native + gtk-titlebar=false: no GTK titlebar; KWin decorates instead
# (was "tabs", but the tab bar is never shown and the GTK titlebar goes
# fully transparent under background-opacity)
gtk-titlebar-style = native
gtk-toolbar-style = flat
gtk-wide-tabs = false

window-show-tab-bar = never

window-height = 36
window-width = 120
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true

# ------------------------------------------------------------
# Ghostty pane management without arrow keys
# ------------------------------------------------------------

# Vim-style pane navigation
# Mental model: Ctrl+W, then h/j/k/l, like Vim window movement.
keybind = ctrl+w>h=goto_split:left
keybind = ctrl+w>j=goto_split:down
keybind = ctrl+w>k=goto_split:up
keybind = ctrl+w>l=goto_split:right

# Vim-style split creation
# Ctrl+W, v = vertical split: panes side-by-side
# Ctrl+W, s = horizontal split: panes stacked
keybind = ctrl+w>v=new_split:right
keybind = ctrl+w>s=new_split:down

# Useful extras
keybind = ctrl+w>z=toggle_split_zoom
keybind = ctrl+w>q=close_surface
keybind = ctrl+w>e=equalize_splits

# Optional: resize panes with Vim directions
keybind = ctrl+w>shift+h=resize_split:left,20
keybind = ctrl+w>shift+j=resize_split:down,20
keybind = ctrl+w>shift+k=resize_split:up,20
keybind = ctrl+w>shift+l=resize_split:right,20

# Shaders (run in order; frost first so the cursor trail stays crisp).
# frosted-glass fakes acrylic by dithering the translucent background —
# ghostty 1.3.x can't request real KWin blur on Plasma 6.7 (see shader).
custom-shader = shaders/frosted-glass.glsl
custom-shader = shaders/cursor-warp.glsl

# SSH Compat
shell-integration = detect
shell-integration-features = ssh-env,ssh-terminfo

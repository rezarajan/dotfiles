// Zed settings
//
// Keep the editor close to the nvim workflow: Vim mode, picker-first
// navigation, hidden tabs, and closed side panels by default.
{
  "ui_font_family": ".ZedSans",
  "agent": {
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.5",
      "enable_thinking": true,
      "effort": "medium"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "fast": false,
        "mode": "auto",
        "model": "opus[1m]"
      },
      "type": "registry"
    }
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "buffer_line_height": "standard",
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark Soft",
  },
  "tab_bar": {
    "show": false,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "tabs": {
    "activate_on_close": "history",
    "file_icons": false,
    "git_status": false,
    "show_close_button": "hidden",
    "show_diagnostics": "off",
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": true,
    "code_actions": false,
  },
  "project_panel": {
    "starts_open": false,
    "button": false,
    "auto_reveal_entries": false,
    "auto_fold_dirs": true,
    "hide_root": true,
    "entry_spacing": "standard",
    "indent_guides": {
      "show": "never",
    },
    "sort_mode": "mixed",
  },
  "outline_panel": {
    "button": false,
    "auto_reveal_entries": false,
    "auto_fold_dirs": true,
    "indent_guides": {
      "show": "never",
    },
  },
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_project_panel": true,
    "enable_preview_from_file_finder": true,
    "enable_preview_from_multibuffer": true,
    "enable_preview_multibuffer_from_code_navigation": false,
    "enable_preview_file_from_code_navigation": true,
    "enable_keep_preview_on_code_navigation": false,
  },
  "close_on_file_delete": true,
  "when_closing_with_no_tabs": "keep_window_open",
}

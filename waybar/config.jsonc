// Waybar — Gruvbox Dragon. Flush 34px top bar mirroring the KDE panel:
// workspaces + window title left; system status, tray and clock right.
// Colors live in colors.css (generated; switched by hypr/scripts/theme-mode.sh).
{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 2,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["mpris"],
    "modules-right": [
        "custom/recording",
        "custom/privacy",
        "tray",
        "memory",
        "network",
        "bluetooth",
        "group/audio",
        "battery",
        "custom/clock",
        "custom/theme",
        "custom/help",
        "custom/notifications",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true
    },

    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true
    },

    "custom/recording": {
        "exec": "test -f \"${XDG_RUNTIME_DIR:-/tmp}/gruvbox-recording\" && echo '{\"text\": \"● REC\", \"class\": \"active\", \"tooltip\": \"Recording — Super+Shift+R stops\"}' || echo '{\"text\": \"\"}'",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "bash ~/.config/hypr/scripts/record.sh toggle"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    },

    "memory": {
        "format": "<span size='115%'>󰍛</span> {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },

    "network": {
        "format-wifi": "<span size='130%'>󰤨</span> {essid}",
        "format-ethernet": "<span size='130%'>󰈀</span>",
        "format-disconnected": "<span size='130%'>󰤭</span>",
        "tooltip-format": "{ifname}: {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}\nClick: networks · right-click: editor",
        "interval": 5,
        "max-length": 18,
        "on-click": "bash ~/.config/hypr/scripts/network-menu.sh",
        "on-click-right": "bash ~/.config/hypr/scripts/panel.sh network"
    },

    "bluetooth": {
        "format": "<span size='130%'>󰂯</span>",
        "format-disabled": "",
        "format-no-controller": "",
        "format-connected": "<span size='130%'>󰂱</span> {num_connections}",
        "tooltip-format": "{status}\nClick: bluetooth settings",
        "tooltip-format-connected": "{device_enumerate}\nClick: bluetooth settings",
        "on-click": "bash ~/.config/hypr/scripts/panel.sh bluetooth"
    },

    // mic / camera in-use indicator (KDE privacy chip); click opens the
    // mixer dropdown on the live streams, right-click switches microphone
    "custom/privacy": {
        "exec": "bash ~/.config/hypr/scripts/privacy-status.sh",
        "return-type": "json",
        "interval": 3,
        "on-click": "bash ~/.config/hypr/scripts/panel.sh audio",
        "on-click-right": "bash ~/.config/hypr/scripts/audio.sh source"
    },

    // light/dark toggle; theme-mode.sh signals RTMIN+9 after switching
    "custom/theme": {
        "exec": "if [ \"$(cat ${XDG_STATE_HOME:-$HOME/.local/state}/gruvbox/mode 2>/dev/null)\" = light ]; then echo '{\"text\":\"󰖨\",\"tooltip\":\"Light mode — click for dark\"}'; else echo '{\"text\":\"󰽥\",\"tooltip\":\"Dark mode — click for light\"}'; fi",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "on-click": "bash ~/.config/hypr/scripts/theme-mode.sh toggle"
    },

    // KDE-style audio: hover slides out a volume slider, click drops the
    // mixer applet down from the bar (see hypr/scripts/audio-panel.sh)
    "group/audio": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "children-class": "audio-drawer"
        },
        "modules": ["pulseaudio", "pulseaudio/slider"]
    },

    "pulseaudio": {
        "format": "<span size='130%'>{icon}</span> {volume}%",
        "format-muted": "<span size='130%'>󰝟</span>",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "format-source": "󰍬",
        "format-source-muted": "󰍭",
        "on-click": "bash ~/.config/hypr/scripts/panel.sh audio",
        "on-click-right": "bash ~/.config/hypr/scripts/audio.sh sink",
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "{desc}\nClick: mixer · right-click: switch device"
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "<span size='115%'>{icon}</span> {capacity}%",
        "format-charging": "<span size='115%'>󰂄</span> {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}"
    },

    // script-backed clock: Gregorian + Hijri in the tooltip (the calendar
    // list is configurable at the top of scripts/clock.sh)
    "custom/clock": {
        "exec": "bash ~/.config/hypr/scripts/clock.sh",
        "return-type": "json",
        "interval": 30
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip-format": "Session menu",
        "on-click": "bash ~/.config/hypr/scripts/power-menu.sh"
    },

    "custom/help": {
        "format": "󰋖",
        "tooltip-format": "Keybindings (Super+F1)",
        "on-click": "bash ~/.config/hypr/scripts/keybinds-help.sh"
    },

    // media controls: shows the playing track, click toggles, scroll seeks;
    // the swaync control center carries the full card with artwork
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "dynamic-order": ["artist", "title"],
        "dynamic-len": 45,
        "interval": 2,
        "player-icons": { "default": "󰝚", "spotify": "󰓇", "firefox": "󰈹",
                          "chromium": "󰊯", "mpv": "󰐹" },
        "status-icons": { "paused": "󰏤", "stopped": "󰓛" },
        "on-click": "bash ~/.config/hypr/scripts/panel.sh media",
        "on-click-right": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "tooltip-format": "{player}: {title}\n{artist} — {album}\nClick: media panel · right: play/pause · scroll: track"
    },

    "custom/notifications": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛"
        },
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true,
        "tooltip": false
    }
}
